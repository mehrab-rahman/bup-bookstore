NODE_ENV=development
HOST=127.0.0.1
PORT=3000
SITE_URL=http://127.0.0.1:3000
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0&directConnection=true
MONGODB_DB=bup_bookstore
# Generate a private value using the README command. Required in production.
SESSION_SECRET=
TRUST_PROXY=0
DELIVERY_FEE=60
STORE_ACTIVE=1
# Set your email provider's credentials to deliver registration/order/restock emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=BUP Bookstore <bookstore@example.com>
